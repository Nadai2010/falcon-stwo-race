+            let denominators = points
+                .iter()
+                .map(|points| (prx - points.x) * piy - (pry - points.y) * pix)
+                .collect::<Vec<_>>();
+            let inverses = PackedCM31::batch_inverse(&denominators);
+            for (k, (points, den_inv)) in zip(points, inverses).enumerate() {
+                let domain_idx = chunk_start + k;
+                let dst_value =
+                    PackedSecureField::from_packed_m31s(std::array::from_fn(|c| dst.0[c].0[k]));
+                let mut partial_numerator = match &partial {
+                    // The accumulation lifted to the subdomain: lanes of its vector
+                    // `domain_idx >> log_ratio`, as `lift_and_accumulate` places them.
+                    Some(partial) => PackedSecureField::from_packed_m31s(std::array::from_fn(|c| {
+                        let lifted = to_lifted_simd(
+                            partial.columns[c].data[domain_idx >> log_ratio].into_simd(),
+                            log_ratio,
+                            domain_idx,
+                        );
+                        PackedBaseField::from_array(lifted.to_array().map(BaseField::from_u32_unchecked))
+                    })),
+                    None if in_place => dst_value,
+                    None => PackedSecureField::zero(),
+                };
+                if !term_columns.is_empty() {
+                    for (column, c) in &term_columns {
+                        partial_numerator += *c * column[domain_idx];
+                    }
+                    partial_numerator += neg_b_sum;
+                }
+                let numerator = partial_numerator - first_linear_term * points.y;
+                // (The first point adds to zero, as the quotients' zeros did.)
+                let accumulated = if first { PackedSecureField::zero() } else { dst_value };
+                let sum = accumulated + numerator * den_inv;
+                for (c, value) in sum.into_packed_m31s().into_iter().enumerate() {
+                    dst.0[c].0[k] = value;
+                }
+            }
+        });
+        quotients = Some(dst_column);
+    }
+    drop(subdomain_points);
+    quotients.unwrap_or_else(|| SecureColumnByCoords::<SimdBackend>::zeros(subdomain_len))
+}
