+    /// The composition's accumulation of the components that `select` picks (by index), added to
+    /// `state`: each component with the random coefficient powers of its own place in the
+    /// composition, and its rows added to the columns the others fill, exactly, so that the
+    /// components may be accumulated in several calls, in any order, with the trace changed in
+    /// between (see [`crate::prover::prove_ex`]). Extending mode only.
+    pub fn accumulate_composition(
+        &self,
+        random_coeff: SecureField,
+        trace: &Trace<'_, B>,
+        _log_blowup_factor: u32,
+        select: &dyn Fn(usize) -> bool,
+        state: Option<CompositionState<B>>,
+    ) -> CompositionState<B> {
+        let total_constraints: usize = self.components.iter().map(|c| c.n_constraints()).sum();
+        let evaluation_mode = EvaluationMode::ExtendToEvalDomain;
+        let max_log_size = self.components().composition_log_degree_bound();
+        // A first part that does not reach the composition's size accumulates at the size of its
+        // largest member (its rows lifted there), not into a column of the composition's size: the
+        // next part lifts it, exactly, when it finishes.
+        let part_log_size = if state.is_none() {
+            self.components
+                .iter()
+                .enumerate()
+                .filter(|(index, _)| select(*index))
+                .map(|(_, component)| component.max_constraint_log_degree_bound())
+                .max()
+                .unwrap_or(max_log_size)
+        } else {
+            max_log_size
+        };
+        let powers = B::generate_secure_powers(random_coeff, total_constraints);
+        // The components by evaluation size, each with its slice of the powers (handed out from
+        // the end in component order).
+        let mut end = total_constraints;
+        let mut groups: Vec<(u32, Vec<(usize, core::ops::Range<usize>)>)> = vec![];
+        for (index, component) in self.components.iter().enumerate() {
+            let n = component.n_constraints();
+            let start = end - n;
+            let log_size = component.max_constraint_log_degree_bound();
+            if select(index) {
+                match groups.iter_mut().find(|(size, _)| *size == log_size) {
+                    Some((_, members)) => members.push((index, start..end)),
+                    None => groups.push((log_size, vec![(index, start..end)])),
+                }
+            }
+            end = start;
+        }
+        let CompositionState { mut sub_accumulations, mut carry } = state.unwrap_or_else(|| {
+            CompositionState {
+                sub_accumulations: (0..=max_log_size as usize).map(|_| None).collect(),
+                carry: None,
