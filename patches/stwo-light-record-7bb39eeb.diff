+/// Packs `values` (one tuple of `N` elements per packed row) as a [`CompactLookupColumn`]: one pass
+/// over the rows for each element's range, one to write them.
+pub fn compact_lookup_tuples<const N: usize>(values: Vec<[PackedM31; N]>) -> CompactLookupColumn {
+    use rayon::prelude::*;
+    let n_packed_rows = values.len();
+    let first: [u32; N] =
+        std::array::from_fn(|j| values.first().map_or(0, |row| row[j].to_array()[0].0));
+    let (maxes, constant) = values
+        .par_iter()
+        .fold(
+            || ([0u32; N], [true; N]),
+            |(mut maxes, mut constant), row| {
+                for j in 0..N {
+                    for value in row[j].to_array() {
+                        maxes[j] = maxes[j].max(value.0);
+                        constant[j] &= value.0 == first[j];
+                    }
+                }
+                (maxes, constant)
+            },
+        )
+        .reduce(
+            || ([0u32; N], [true; N]),
+            |(a, x), (b, y)| {
+                (std::array::from_fn(|j| a[j].max(b[j])), std::array::from_fn(|j| x[j] && y[j]))
+            },
+        );
+    let widths = (0..N)
+        .map(|j| if constant[j] { 0 } else { (32 - maxes[j].leading_zeros() as usize).div_ceil(8).max(1) })
+        .collect::<Vec<_>>();
+    let stride = N_LANES * widths.iter().sum::<usize>();
+    let mut data = vec![0u8; n_packed_rows * stride];
+    if stride > 0 {
+        data.par_chunks_mut(stride).zip(values.par_iter()).for_each(|(dst, row)| {
+            let mut offset = 0;
+            for (j, &width) in widths.iter().enumerate() {
+                if width == 0 {
+                    continue;
+                }
+                let lanes = row[j].to_array();
+                let dst = &mut dst[offset..offset + N_LANES * width];
+                match width {
+                    1 => dst.iter_mut().zip(lanes).for_each(|(d, v)| *d = v.0 as u8),
+                    2 => dst.chunks_exact_mut(2).zip(lanes).for_each(|(d, v)| {
+                        d.copy_from_slice(&(v.0 as u16).to_le_bytes())
+                    }),
+                    3 => dst.chunks_exact_mut(3).zip(lanes).for_each(|(d, v)| {
+                        d.copy_from_slice(&v.0.to_le_bytes()[..3])
+                    }),
+                    _ => dst.chunks_exact_mut(4).zip(lanes).for_each(|(d, v)| {
+                        d.copy_from_slice(&v.0.to_le_bytes())
+                    }),
+                }
+                offset += N_LANES * width;
+            }
+        });
+    }
+    CompactLookupColumn { n_packed_rows, widths, constants: first.to_vec(), stride, data }
+}
+
+/// The tuples [`compact_lookup_tuples`] packed.
+pub fn expand_lookup_tuples<const N: usize>(column: CompactLookupColumn) -> Vec<[PackedM31; N]> {
+    use rayon::prelude::*;
+    let CompactLookupColumn { n_packed_rows, widths, constants, stride, data } = column;
+    (0..n_packed_rows)
+        .into_par_iter()
+        .map(|packed_row| {
+            let src = &data[packed_row * stride..(packed_row + 1) * stride];
+            let mut offset = 0;
+            std::array::from_fn(|j| {
+                let width = widths[j];
+                if width == 0 {
+                    return PackedM31::broadcast(M31::from_u32_unchecked(constants[j]));
+                }
+                let src = &src[offset..offset + N_LANES * width];
+                offset += N_LANES * width;
+                let lanes: [M31; N_LANES] = match width {
+                    1 => std::array::from_fn(|l| M31::from_u32_unchecked(src[l] as u32)),
+                    2 => std::array::from_fn(|l| {
+                        M31::from_u32_unchecked(u16::from_le_bytes([src[2 * l], src[2 * l + 1]]) as u32)
+                    }),
+                    3 => std::array::from_fn(|l| {
+                        M31::from_u32_unchecked(u32::from_le_bytes([
+                            src[3 * l],
+                            src[3 * l + 1],
+                            src[3 * l + 2],
+                            0,
+                        ]))
+                    }),
+                    _ => std::array::from_fn(|l| {
+                        M31::from_u32_unchecked(u32::from_le_bytes([
+                            src[4 * l],
+                            src[4 * l + 1],
+                            src[4 * l + 2],
+                            src[4 * l + 3],
+                        ]))
+                    }),
+                };
+                PackedM31::from_array(lanes)
+            })
+        })
+        .collect()
+}
+
+/// [`compact_lookup_tuples`] of a column of single values.
+pub fn compact_lookup_values(values: Vec<PackedM31>) -> CompactLookupColumn {
+    compact_lookup_tuples::<1>(values.into_iter().map(|value| [value]).collect())
+}
+
+/// The values [`compact_lookup_values`] packed.
+pub fn expand_lookup_values(column: CompactLookupColumn) -> Vec<PackedM31> {
+    expand_lookup_tuples::<1>(column).into_iter().map(|[value]| value).collect()
+}
+
+/// Defines `$compact`, a component's `$data` (its lookup data) with every tuple and value column
+/// kept narrow ([`CompactLookupColumn`]), and the conversions between the two.
+macro_rules! compact_lookup_data {
+    ($data:ident => $compact:ident {
+        tuples: [$($tuple:ident),* $(,)?],
+        values: [$($value:ident),* $(,)?],
+        other: [$($other:ident: $ty:ty),* $(,)?] $(,)?
+    }) => {
+        struct $compact {
+            $($tuple: $crate::witness::utils::CompactLookupColumn,)*
+            $($value: $crate::witness::utils::CompactLookupColumn,)*
+            $($other: $ty,)*
+        }
+        impl $data {
+            fn compact(self) -> $compact {
+                $compact {
+                    $($tuple: $crate::witness::utils::compact_lookup_tuples(self.$tuple),)*
+                    $($value: $crate::witness::utils::compact_lookup_values(self.$value),)*
+                    $($other: self.$other,)*
+                }
+            }
+        }
+        impl $compact {
+            fn expand(self) -> $data {
+                $data {
+                    $($tuple: $crate::witness::utils::expand_lookup_tuples(self.$tuple),)*
+                    $($value: $crate::witness::utils::expand_lookup_values(self.$value),)*
+                    $($other: self.$other,)*
+                }
+            }
+        }
+    };
+}
