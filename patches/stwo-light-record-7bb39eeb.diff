+static LARGE_BLOCKS: LargeBlocks = LargeBlocks {
+    idle: AtomicUsize::new(0),
+    counts: [const { AtomicUsize::new(0) }; LARGE_CLASSES],
+    slots: [const { [const { AtomicUsize::new(0) }; LARGE_SLOTS] }; LARGE_CLASSES],
