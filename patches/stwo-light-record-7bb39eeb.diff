+/// The rows of a block of a [`CompactColumn::Packed`] column.
+const PACKED_BLOCK: usize = 32;
+
+/// A preprocessed column, stored in the narrowest representation that reproduces its exact
+/// `usize` values.
+///
+/// Narrowing is always checked: a value is stored at a smaller width only when it fits exactly,
+/// so the column's values, length and order are identical to the materialized `Vec<usize>` it
+/// replaces. A column containing any value above `u32::MAX` is kept `Wide`, unchanged.
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum CompactColumn {
+    /// Every value fits in a `u32`.
+    Narrow(Vec<u32>),
+    /// Every value fits in a `u32`, stored as frame-of-reference blocks of [`PACKED_BLOCK`] rows:
+    /// block `b` keeps its least value `bases[b]`, and each of its rows the excess over it, in
+    /// `widths[b]` bits, packed LSB-first into `words` from bit `starts[b]`. The gate address
+    /// columns (most of the circuit's preprocessed bytes) are runs of nearby addresses, so they
+    /// take a quarter of their `u32` width or less, and any row is still read in O(1).
+    Packed { len: usize, bases: Vec<u32>, widths: Vec<u8>, starts: Vec<u32>, words: Vec<u64> },
+    /// General fallback: the column contains some value above `u32::MAX`.
+    Wide(Vec<usize>),
+    /// Every value is 0 or 1. `words` packs the rows LSB-first, 64 rows per word; `len` is the
+    /// row count (the last word's bits past `len` are zero).
+    Bits { len: usize, words: Vec<u64> },
+    /// A fixed lookup-table column, expanded from its value formula instead of being stored.
+    Fixed { log_size: u32, kind: FixedColumnKind },
+}
+
+impl CompactColumn {
+    /// Compacts a materialized column into the narrowest representation holding its exact values.
+    fn compact(column: Vec<usize>) -> Self {
+        if column.iter().all(|&value| value <= 1) {
+            // `value` is 0 or 1, so the `u64` conversion is lossless.
+            let mut words = vec![0_u64; column.len().div_ceil(64)];
+            for (row, &value) in column.iter().enumerate() {
+                words[row / 64] |= (value as u64) << (row % 64);
+            }
+            return Self::Bits { len: column.len(), words };
+        }
+        let narrow: Result<Vec<u32>, _> =
+            column.iter().map(|&value| u32::try_from(value)).collect();
+        match narrow {
+            Ok(narrow) => Self::pack(narrow),
+            Err(_) => Self::Wide(column),
+        }
+    }
+
+    /// `Packed` when that is smaller than `Narrow`, which it is unless the column is short or its
+    /// neighbouring rows are far apart.
+    fn pack(values: Vec<u32>) -> Self {
+        let n_blocks = values.len().div_ceil(PACKED_BLOCK);
+        let mut bases = Vec::with_capacity(n_blocks);
+        let mut widths = Vec::with_capacity(n_blocks);
+        let mut starts = Vec::with_capacity(n_blocks);
+        let mut n_bits = 0_usize;
+        for block in values.chunks(PACKED_BLOCK) {
+            let (min, max) = (*block.iter().min().unwrap(), *block.iter().max().unwrap());
+            let width = u32::BITS - (max - min).leading_zeros();
+            let Ok(start) = u32::try_from(n_bits) else { return Self::Narrow(values) };
+            bases.push(min);
+            widths.push(width as u8);
+            starts.push(start);
+            n_bits += width as usize * block.len();
+        }
+        // One spare word, so that a value's second word always exists.
+        let n_words = n_bits.div_ceil(64) + 1;
+        if n_words * 8 + n_blocks * 9 >= values.len() * 4 {
+            return Self::Narrow(values);
+        }
+        let mut words = vec![0_u64; n_words];
+        for (block, chunk) in values.chunks(PACKED_BLOCK).enumerate() {
+            let width = widths[block] as usize;
+            let mut bit = starts[block] as usize;
+            for &value in chunk {
+                let excess = u64::from(value - bases[block]);
+                let shift = bit % 64;
+                words[bit / 64] |= excess << shift;
+                if shift + width > 64 {
+                    words[bit / 64 + 1] |= excess >> (64 - shift);
+                }
+                bit += width;
+            }
+        }
+        Self::Packed { len: values.len(), bases, widths, starts, words }
+    }
+
+    /// The `width`-bit excess of a `Packed` column that starts at bit `bit` of `words`.
+    #[inline(always)]
+    fn unpack(words: &[u64], bit: usize, width: usize) -> u64 {
+        if width == 0 {
+            return 0;
+        }
+        let shift = bit % 64;
+        let mut excess = words[bit / 64] >> shift;
+        if shift + width > 64 {
+            excess |= words[bit / 64 + 1] << (64 - shift);
+        }
+        excess & ((1_u64 << width) - 1)
+    }
+
+    /// Calls `f` on the values of a `Packed` column's rows, in order (a block at a time, so that
+    /// a whole column is expanded faster than through [`Self::at`]). Not for other columns.
+    #[inline(always)]
+    fn for_each_packed(&self, f: impl FnMut(u32)) {
+        self.for_each_packed_in(0..self.len(), f);
+    }
+
+    /// [`Self::for_each_packed`] on the rows of `rows`, which starts at a multiple of
+    /// [`PACKED_BLOCK`].
+    #[inline(always)]
+    fn for_each_packed_in(&self, rows: std::ops::Range<usize>, mut f: impl FnMut(u32)) {
+        let Self::Packed { bases, widths, starts, words, .. } = self else {
+            unreachable!("not a packed column")
+        };
+        debug_assert_eq!(rows.start % PACKED_BLOCK, 0);
+        let blocks = rows.start / PACKED_BLOCK..rows.end.div_ceil(PACKED_BLOCK);
+        for block in blocks {
+            let (base, width) = (bases[block], widths[block] as usize);
+            let mut bit = starts[block] as usize;
+            for _ in block * PACKED_BLOCK..rows.end.min((block + 1) * PACKED_BLOCK) {
+                f(base + Self::unpack(words, bit, width) as u32);
+                bit += width;
+            }
+        }
+    }
+
+    /// The number of rows in the column.
+    fn len(&self) -> usize {
+        match self {
+            Self::Narrow(values) => values.len(),
+            Self::Wide(values) => values.len(),
+            Self::Bits { len, .. } => *len,
+            Self::Packed { len, .. } => *len,
+            Self::Fixed { log_size, .. } => 1_usize << log_size,
+        }
+    }
+
+    /// The value at `row`, without any allocation.
+    fn at(&self, row: usize) -> usize {
+        match self {
+            Self::Narrow(values) => usize::try_from(values[row]).expect("value originally fit usize"),
+            Self::Wide(values) => values[row],
+            Self::Bits { words, .. } => ((words[row / 64] >> (row % 64)) & 1) as usize,
+            Self::Packed { bases, widths, starts, words, .. } => {
+                let block = row / PACKED_BLOCK;
+                let width = widths[block] as usize;
+                let bit = starts[block] as usize + row % PACKED_BLOCK * width;
+                bases[block] as usize + Self::unpack(words, bit, width) as usize
+            }
+            Self::Fixed { log_size, kind } => kind.at(*log_size, row),
+        }
+    }
+
+    /// Materializes the column's exact values.
+    fn to_vec(&self) -> Vec<usize> {
+        match self {
+            Self::Narrow(values) => values.iter().map(|&value| usize::try_from(value).expect("value originally fit usize")).collect(),
+            Self::Wide(values) => values.clone(),
+            Self::Packed { len, .. } => {
+                let mut values = Vec::with_capacity(*len);
+                self.for_each_packed(|value| values.push(value as usize));
+                values
+            }
+            _ => (0..self.len()).map(|row| self.at(row)).collect(),
+        }
+    }
+
+    /// Expands the column directly to a field column, with no intermediate `usize` array. Every
+    /// value goes through the same `BaseField::from(usize)` conversion as a materialized column.
+    #[cfg(feature = "prover")]
+    fn to_field_column<B: Backend>(&self) -> Col<B, BaseField> {
+        match self {
+            Self::Narrow(values) => Col::<B, BaseField>::from_iter(
+                values.iter().map(|&value| BaseField::from(usize::try_from(value).expect("value originally fit usize"))),
+            ),
+            Self::Wide(values) => {
+                Col::<B, BaseField>::from_iter(values.iter().cloned().map(BaseField::from))
+            }
+            _ => Col::<B, BaseField>::from_iter(
+                (0..self.len()).map(|row| BaseField::from(self.at(row))),
+            ),
