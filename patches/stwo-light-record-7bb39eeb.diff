+
+impl<const N: usize> InputToRow<N> {
+    pub fn rows_packed(&self, input: &[PackedM31; N]) -> [u32; 16] {
+        if self.fields.is_empty() {
+            let lanes = input.map(|p| p.to_array());
+            std::array::from_fn(|l| {
+                self.row(&std::array::from_fn(|i| lanes[i][l])).try_into().unwrap()
