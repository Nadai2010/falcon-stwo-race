+    let gl: u128 = upcast(gl);
+    let c4 = gh ^ gl ^ g4;
+    let (c1, c0) = split_exact_k(cc01, k.two64);
+    let (c3, c2) = split_exact_k(cc23, k.two64);
+    let r0 = rotl_exact_k_1(c0, k.d1);
+    let r1 = rotl_exact_k_1(c1, k.d1);
+    let r2 = rotl_exact_k_1(c2, k.d1);
+    let r3 = rotl_exact_k_1(c3, k.d1);
+    let r4 = rotl_k(c4, 0x2, k.two64);
+    let c0u: u128 = upcast(c0);
+    let r3u: u128 = upcast(r3);
+    let c3u: u128 = upcast(c3);
+    let r0u: u128 = upcast(r0);
+    // (d0, d1), (d2, d3) packed; d4 alone and doubled for column 4's pairs.
+    let d01 = pack(c4, c0u) ^ pack_exact(r1, r2);
+    let d23 = pack_exact(c1, c2) ^ pack(r3u, r4);
+    let d4 = c3u ^ r0u;
+    let dd4 = pack(d4, d4);
+    // theta applied, then the lanes split for rho.
+    let (a01, a00) = split_exact_k(u0 ^ d01, k.two64);
+    let (a03, a02) = split_exact_k(v0 ^ d23, k.two64);
+    let (a06, a05) = split_exact_k(u1 ^ d01, k.two64);
+    let (a08, a07) = split_exact_k(v1 ^ d23, k.two64);
+    let (a11, a10) = split_exact_k(u2 ^ d01, k.two64);
+    let (a13, a12) = split_exact_k(v2 ^ d23, k.two64);
+    let (a16, a15) = split_exact_k(u3 ^ d01, k.two64);
+    let (a18, a17) = split_exact_k(v3 ^ d23, k.two64);
+    let (a21, a20) = split_exact_k(u4 ^ d01, k.two64);
+    let (a23, a22) = split_exact_k(v4 ^ d23, k.two64);
+    let (a09, a04) = split_exact_k(g01 ^ dd4, k.two64);
+    let (a19, a14) = split_exact_k(g23 ^ dd4, k.two64);
