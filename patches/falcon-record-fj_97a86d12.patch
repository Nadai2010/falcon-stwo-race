+/// One Keccak-f round (theta, rho, pi, chi, iota) on the packed state, stored by column
+/// pairs: per row `y`, `u[y]` holds lanes (0, y) and (1, y) (low and high 64 bits) and `v[y]`
+/// lanes (2, y) and (3, y); column 4 is carried as the pairs ((4, 0), (4, 1)) and
+/// ((4, 2), (4, 3)) plus lane (4, 4). theta's parities of columns 0-1 and 2-3 are then
+/// XORs of whole words, and chi, which works along rows, produces the same layout.
+#[inline(always)]
+fn keccak_round(st: [u128; 13], rc: u128, k: RoundConsts) -> [u128; 13] {
+    let [u0, u1, u2, u3, u4, v0, v1, v2, v3, v4, g01, g23, g4] = st;
+    // theta: column parities, packed for columns 0-1 and 2-3.
+    let cc01 = u0 ^ u1 ^ u2 ^ u3 ^ u4;
+    let cc23 = v0 ^ v1 ^ v2 ^ v3 ^ v4;
