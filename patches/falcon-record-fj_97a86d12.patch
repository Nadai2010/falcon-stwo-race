+        push4_raw(g4, g5, g6, g7, ref coeffs, k);
+        push_word8_raw(u2, ref coeffs, k);
+        push_word8_raw(v2, ref coeffs, k);
+        let (h0, h1, h2, h3) = low_lane_chunks(swap_word(g23, k), k);
