+    // (a + offset) - b: the constant is added as an immediate, never copied.
+    let (_, r) = bounded_int::div_rem(bounded_int::sub(bounded_int::add(a, offset), b), q);
+    let c = bounded_int::sub(r, half);
+    bounded_int::mul(c, c).into()
+}
