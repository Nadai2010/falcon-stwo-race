+/// whole, each just before its candidates; lanes 4 and 9 come from the column-4 pair
+/// (4, 9), and lane 14 from (14, 19).
+#[inline(always)]
+fn push_block_raw(state: @[u128; 13], ref coeffs: Array<u16>, k: SqueezeConsts) {
