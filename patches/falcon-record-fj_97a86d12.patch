+    }
+    if let U128sFromFelt252Result::Wide(_) = u128s_from_felt252(hint_quotient(a3, d3, c3, k)) {
+        return false;
+    }
+    if let U128sFromFelt252Result::Wide(_) = u128s_from_felt252(hint_quotient(a4, d4, c4, k)) {
+        return false;
+    }
+    if let U128sFromFelt252Result::Wide(_) = u128s_from_felt252(hint_quotient(a5, d5, c5, k)) {
+        return false;
+    }
+    if let U128sFromFelt252Result::Wide(_) = u128s_from_felt252(hint_quotient(a6, d6, c6, k)) {
