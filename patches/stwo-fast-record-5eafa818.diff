+        PackedBaseField::reduce_simd(lanes.select(a.into_simd(), b.into_simd()))
+    };
+    let (even, odd) = (even / 16, odd / 16);
+    Some(VeryPackedBaseField::from([blend(data[even], data[odd]), blend(data[even + 1], data[odd + 1])]))
+}
