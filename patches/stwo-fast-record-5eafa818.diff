+        #[cfg(not(feature = "parallel"))]
+        let evaluations: Vec<CircleEvaluation<B, BaseField, BitReversedOrder>> =
+            chunk.iter().map(source_evaluation).collect();
+        let chunk_domain = evaluations[0].domain;
+        assert!(evaluations.iter().all(|evaluation| evaluation.domain == chunk_domain));
+        assert_eq!(*trace_domain.get_or_insert(chunk_domain), chunk_domain);
+        for ((batch, coeffs), sum) in zip(zip(&sample_batches, &line_coeffs), &mut sums) {
+            let terms: Vec<(&Col<B, BaseField>, SecureField)> =
+                zip(&batch.cols_vals_randpows, coeffs)
+                    .filter(|(data, _)| (first..first + chunk.len()).contains(&data.column_index))
+                    .map(|(data, &(_, _, c))| (&evaluations[data.column_index - first].values, c))
+                    .collect();
+            if terms.is_empty() {
+                continue;
+            }
+            match sum {
+                Some(sum) => B::accumulate_weighted_columns(sum, &terms),
+                None => *sum = Some(B::weighted_columns(chunk_domain.log_size(), &terms)),
+            }
+        }
+    }
+    let trace_domain = trace_domain.expect("a group has columns");
+    zip(zip(sample_batches, line_coeffs), sums)
+        .map(|((batch, coeffs), sum)| {
+            let sum = sum.expect("every sample point has columns");
+            let mut partial_numerators_acc =
+                stripe0_of_coordinates(sum, trace_domain, domain, twiddles);
+            let b_sum: SecureField = coeffs.iter().map(|(_, b, _)| *b).sum();
+            B::canonicalize_and_subtract(&mut partial_numerators_acc, b_sum);
+            AccumulatedNumerators {
+                sample_point: batch.point,
+                partial_numerators_acc,
+                first_linear_term_acc: coeffs.iter().map(|(a, ..)| *a).sum(),
+            }
+        })
+        .collect()
+}
+
+/// Whether the columns of one size that keep their coefficients, `polys`, sampled at `samples`,
+/// are combined before their transforms by [`combined_coefficient_accumulations`]: the backend
+/// supports it, every coefficient column has the same log size, at least
+/// [`MIN_COMBINED_LOG_SIZE`], and the combination saves transforms (one per coordinate and sample
+/// point, four per point, where the per-column path transforms each column once).
+fn combines_coefficient_columns<B: Backend>(
+    polys: &[&Poly<B>],
+    samples: &[&Vec<(PointSample, SecureField)>],
+) -> bool {
+    if !B::COMBINES_SOURCED_COLUMNS {
+        return false;
+    }
+    let Some(log_size) = polys.first().and_then(|poly| poly.coeffs.as_ref()).map(|c| c.log_size())
+    else {
+        return false;
+    };
+    if log_size < MIN_COMBINED_LOG_SIZE
+        || polys.iter().any(|poly| poly.coeffs.as_ref().map(|c| c.log_size()) != Some(log_size))
+    {
+        return false;
+    }
+    let n_points = ColumnSampleBatch::new_vec(samples).len();
+    polys.len() > SECURE_EXTENSION_DEGREE * n_points
+}
+
+/// [`combined_sourced_accumulations`] for columns that keep their coefficients: per sample point
+/// the coefficients are summed as `∑ cᵢ * coeffsᵢ` over the point's columns, and each of the four
+/// coordinates of the sum is evaluated on stripe 0 of `domain` once, canonicalized, and offset by
+/// `-∑ bᵢ`. Evaluation is linear, so stripe 0 of the sum is `∑ cᵢ * fᵢ`, `fᵢ` column `i`'s stripe 0
+/// (the one the column would get back as its stripe 0), modulo `P`; once canonical the values are
+/// those of the per-column path word for word, as in [`combined_sourced_accumulations`].
+fn combined_coefficient_accumulations<B: Backend>(
+    polys: &[&Poly<B>],
+    samples: &[&Vec<(PointSample, SecureField)>],
+    domain: CircleDomain,
+    twiddles: &TwiddleTree<B>,
+) -> Vec<AccumulatedNumerators<B>> {
+    let sample_batches: Vec<ColumnSampleBatch> = ColumnSampleBatch::new_vec(samples);
+    let line_coeffs: Vec<Vec<(SecureField, SecureField, SecureField)>> =
+        quotient_constants(&sample_batches).line_coeffs;
+    let log_size = polys[0].coeffs.as_ref().expect("coefficient columns").log_size();
+    let per_point = |(batch, coeffs): (ColumnSampleBatch, Vec<(SecureField, SecureField, SecureField)>)| {
+        let terms: Vec<(&Col<B, BaseField>, SecureField)> = zip(&batch.cols_vals_randpows, &coeffs)
+            .map(|(data, &(_, _, c))| {
+                (&polys[data.column_index].coeffs.as_ref().unwrap().coeffs, c)
+            })
+            .collect();
+        let sum = B::weighted_columns(log_size, &terms);
+        let evaluate = |column: Col<B, BaseField>| {
+            // Every value is written by the FFT: taken as the pool's FFT buffers are, not zeroed.
+            let mut stripe =
+                crate::prover::mempool::BaseColumnPool::<B>::new().take_or_alloc(log_size);
+            B::evaluate_stripe_into(&CircleCoefficients::new(column), domain, twiddles, 0, &mut stripe);
+            stripe
+        };
+        let [c0, c1, c2, c3] = sum.columns;
+        #[cfg(feature = "parallel")]
+        let columns = {
+            let ((s0, s1), (s2, s3)) = rayon::join(
+                || rayon::join(|| evaluate(c0), || evaluate(c1)),
+                || rayon::join(|| evaluate(c2), || evaluate(c3)),
+            );
+            [s0, s1, s2, s3]
+        };
+        #[cfg(not(feature = "parallel"))]
+        let columns = [evaluate(c0), evaluate(c1), evaluate(c2), evaluate(c3)];
+        let mut partial_numerators_acc = SecureColumnByCoords { columns };
+        let b_sum: SecureField = coeffs.iter().map(|(_, b, _)| *b).sum();
+        B::canonicalize_and_subtract(&mut partial_numerators_acc, b_sum);
+        AccumulatedNumerators {
+            sample_point: batch.point,
+            partial_numerators_acc,
+            first_linear_term_acc: coeffs.iter().map(|(a, ..)| *a).sum(),
+        }
+    };
+    let points = zip(sample_batches, line_coeffs).collect_vec();
+    // The sample points of a size are independent: up to `CONCURRENT_GROUP_MAX_LOG_SIZE` they
+    // are computed concurrently (each point's sum and its four transforms are short fork-joins
+    // that leave workers idle), in their order. Larger sizes keep one point's transient at a time.
+    #[cfg(feature = "parallel")]
+    {
+        if log_size <= CONCURRENT_GROUP_MAX_LOG_SIZE {
+            return points.into_par_iter().map(&per_point).collect();
+        }
+    }
+    points.into_iter().map(&per_point).collect()
+}
+
+/// The largest trace log size of the regrown quotient groups that [`compute_fri_quotients_with_regrowth`]
+/// computes concurrently, and of the coefficient columns whose sample points are combined concurrently
+/// by [`combined_coefficient_accumulations`]: a point's transient is a weighted sum and its four
+/// transforms, `32 << log_size` bytes, 64 MiB at 2^21.
+const CONCURRENT_GROUP_MAX_LOG_SIZE: u32 = 21;
+
+/// Stripe 0 of `domain` of each coordinate of `values`, given on `trace_domain`: interpolated
+/// with the twiddles of `trace_domain` and evaluated on the first subdomain of `domain` with
+/// `twiddles`, as [`Poly::stripe0`] regrows a sourced column.
+fn stripe0_of_coordinates<B: PolyOps>(
+    values: SecureColumnByCoords<B>,
+    trace_domain: CircleDomain,
+    domain: CircleDomain,
+    twiddles: &TwiddleTree<B>,
+) -> SecureColumnByCoords<B> {
+    let shared_trace_twiddles = B::subdomain_twiddles(trace_domain.half_coset);
+    let trace_twiddles: &TwiddleTree<B> = &shared_trace_twiddles;
+    let stripe0 = |column: Col<B, BaseField>| -> Col<B, BaseField> {
+        let coefficients: CircleCoefficients<B> =
+            CircleEvaluation::<B, BaseField, BitReversedOrder>::new(trace_domain, column)
+                .interpolate_with_twiddles(trace_twiddles);
+        // Every value is written by the FFT: taken as the pool's FFT buffers are, not zeroed.
+        let mut stripe = crate::prover::mempool::BaseColumnPool::<B>::new()
+            .take_or_alloc(coefficients.log_size());
+        B::evaluate_stripe_into(&coefficients, domain, twiddles, 0, &mut stripe);
+        stripe
+    };
+    #[cfg(feature = "parallel")]
+    let columns: Vec<Col<B, BaseField>> = values.columns.into_par_iter().map(stripe0).collect();
+    #[cfg(not(feature = "parallel"))]
+    let columns: Vec<Col<B, BaseField>> = values.columns.into_iter().map(stripe0).collect();
+    SecureColumnByCoords {
+        columns: columns.try_into().unwrap_or_else(|_| unreachable!("four coordinates")),
+    }
+}
