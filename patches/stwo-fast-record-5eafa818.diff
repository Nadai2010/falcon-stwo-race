+/// Appends `parts` to `dst` in order, mapping each element with `f(element, part index)`, on
+/// rayon's workers (each element is written once, into its place).
+fn par_append<T: Send + Sync, U: Send>(
+    dst: &mut Vec<U>,
+    parts: Vec<&Vec<T>>,
+    f: impl Fn(&T, usize) -> U + Sync,
+) {
+    use rayon::prelude::*;
+    let mut starts = Vec::with_capacity(parts.len());
+    let mut total = 0;
+    for part in &parts {
+        starts.push(total);
+        total += part.len();
+    }
+    // Pieces of one length (the queries' checks) locate their part by division; otherwise by a
+    // binary search of the starts.
+    let uniform = parts.first().map(|part| part.len()).filter(|&len| len > 0 && parts.iter().all(|part| part.len() == len));
+    dst.par_extend((0..total).into_par_iter().map(|i| {
+        let k = match uniform {
+            Some(len) => i / len,
+            None => starts.partition_point(|&start| start <= i) - 1,
+        };
+        f(&parts[k][i - starts[k]], k)
+    }));
