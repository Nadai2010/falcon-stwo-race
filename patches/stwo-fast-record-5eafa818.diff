+pub(super) struct ByteRotations {
+    #[cfg(all(target_arch = "x86_64", target_feature = "avx2"))]
+    by16: __m256i,
+    #[cfg(all(target_arch = "x86_64", target_feature = "avx2"))]
+    by8: __m256i,
